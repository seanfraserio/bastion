{
  "name": "bastion",
  "private": true,
  "version": "0.2.7",
  "description": "Open-source security gateway for AI agent traffic",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "pack:check": "node scripts/pack-smoke.mjs",
    "dev": "pnpm -r --parallel run dev",
    "clean": "find . -name dist -type d | xargs rm -rf"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "fdir>picomatch": ">=3.0.2 <5",
      "tinyglobby>picomatch": ">=4.0.4",
      "minimatch@9>brace-expansion": ">=2.1.7 <3",
      "minimatch@10>brace-expansion": ">=5.0.12 <6",
      "@grpc/proto-loader>protobufjs": ">=7.6.6 <8",
      "google-gax>protobufjs": ">=7.6.6 <8",
      "proto3-json-serializer>protobufjs": ">=7.6.6 <8",
      "@protobufjs/utf8": ">=1.1.2",
      "@grpc/grpc-js": ">=1.14.6",
      "ajv>fast-uri": ">=3.1.8 <4",
      "find-my-way": ">=9.10.0"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "~4.1.12",
    "vite": "^7.3.7",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.2.0",
    "semver": "^7.7.2",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "~4.1.12"
  }
}
