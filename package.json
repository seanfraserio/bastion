{
  "name": "bastion",
  "private": true,
  "version": "0.2.7",
  "description": "Open-source security gateway for AI agent traffic",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "clean": "find . -name dist -type d | xargs rm -rf"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "undici@<7": ">=6.24.0 <7",
      "undici@>=7 <8": "7.30.1",
      "brace-expansion": "5.0.11",
      "cookie": ">=0.7.0",
      "next": ">=15.5.28 <16",
      "next>sharp": "0.35.5",
      "sharp": "0.35.5",
      "next-auth": "5.0.0-beta.32",
      "@auth/core": "0.41.3",
      "tinypool": "2.1.2",
      "tar": "7.5.21",
      "protobufjs": "7.6.1",
      "vitest": ">=3.2.6 <4",
      "@grpc/grpc-js": "1.14.5",
      "@opentelemetry/propagator-jaeger": "2.9.0",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.9",
      "fastify": "5.12.2",
      "find-my-way": "9.7.0",
      "ip-address": "10.3.1",
      "js-yaml@^3": "3.15.2",
      "js-yaml@^4": "4.3.2",
      "lodash": "4.18.0",
      "nanoid@^3": "3.3.20",
      "pacote": "21.5.1",
      "postcss": "8.5.23",
      "sigstore": "4.1.1",
      "source-map-js": "1.2.2",
      "tmp": "0.2.7",
      "vite": "6.4.5",
      "zod": "4.6.6",
      "ws": "8.21.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "next": ">=15.5.28 <16"
      }
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
